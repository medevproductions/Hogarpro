rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones auxiliares de autorización
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.role == 'owner' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'admin@hogarpro.com' ||
        request.auth.token.email == 'owner@hogarpro.com'
      );
    }

    function isSeller() {
      return isAuthenticated() && (
        request.auth.token.role == 'seller' || isOwner()
      );
    }

    // Colección: code_requests (Códigos OTP y Enlaces de Acceso)
    match /code_requests/{requestId} {
      // Lectura: Permitida para el Owner o para el vendedor asignado
      allow read: if isOwner() || (
        isSeller() && (
          resource.data.sellerId == request.auth.uid ||
          resource.data.sellerId == request.auth.token.email
        )
      );

      // Creación: Permitida para usuarios autenticados
      allow create: if isAuthenticated();

      // Actualización: Solo administradores o funciones de backend
      allow update: if isOwner();

      // Eliminación: Solo Owner
      allow delete: if isOwner();
    }

    // Colección: streaming_accounts (Cuentas Maestras)
    match /streaming_accounts/{accountId} {
      // El vendedor solo puede leer las cuentas asignadas a él
      allow read: if isOwner() || (
        isSeller() && (
          resource.data.sellerId == request.auth.uid ||
          resource.data.sellerId == request.auth.token.email
        )
      );

      // Solo el propietario puede crear, editar o borrar inventario
      allow write: if isOwner();
    }

    // Colección: sales_records (Ventas) y expense_records (Gastos)
    match /sales_records/{saleId} {
      allow read: if isAuthenticated();
      allow write: if isOwner() || isSeller();
    }

    match /expense_records/{expenseId} {
      allow read, write: if isOwner();
    }

    // Bloqueo por defecto para cualquier otra colección no declarada
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
