rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colección: code_requests (Códigos OTP y Enlaces de Acceso)
    match /code_requests/{requestId} {
      allow read, write: if true;
    }

    // Colección: streaming_accounts (Cuentas Maestras e Importadas)
    match /streaming_accounts/{accountId} {
      allow read, write: if true;
    }

    // Colección: system_users (Vendedores y Revendedores)
    match /system_users/{userId} {
      allow read, write: if true;
    }

    // Colección: sales_records (Ventas)
    match /sales_records/{saleId} {
      allow read, write: if true;
    }

    // Colección: expense_records (Gastos)
    match /expense_records/{expenseId} {
      allow read, write: if true;
    }

    // Regla global de acceso para la aplicación HogarPro
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
